---
import { getCollection } from "astro:content";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import {
  breadcrumbSchema,
  personSchema,
  websiteId,
} from "../utils/schema";

import HeroSection from "../components/AboutMePage/HeroSection.astro";
import ContentSection from "../components/AboutMePage/ContentSection.astro";
import ImageSection from "../components/AboutMePage/ImageSection.astro";
import ValuesSection from "../components/AboutMePage/ValuesSection.astro";
import LogoCloud from "../components/AboutMePage/LogoCloud.astro";
import BlogSection from "../components/AboutMePage/BlogSection.astro";
import TeamSection from "../components/AboutMePage/TeamSection.astro";

// Get the blog posts
const posts = (await getCollection("blog"))
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get the last 3 posts
const recentPosts = posts.slice(0, 3);

const title = "Sobre mí | Baumannzone.dev";
const description =
  "Conoce más sobre Jorge Baumann (@baumannzone) y su trabajo como desarrollador web y creador de contenido.";
const aboutUrl = new URL("/about/", Astro.site).href;
const person = personSchema(Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${aboutUrl}#webpage`,
      url: aboutUrl,
      name: title,
      description,
      inLanguage: "es",
      isPartOf: { "@id": websiteId(Astro.site) },
      mainEntity: { "@id": person["@id"] },
    },
    person,
    breadcrumbSchema(Astro.site, [
      { name: "Inicio", path: "/" },
      { name: "Sobre mí", path: "/about/" },
    ]),
  ],
};
---

<DefaultLayout title={title} description={description} ogType="profile">
  <JsonLd slot="head" data={jsonLd} />
  <div class="bg-white">
    <div class="isolate">
      <HeroSection />

      <ContentSection totalPosts={posts.length} />

      <ImageSection />

      <ValuesSection />

      <LogoCloud />

      <!-- <TeamSection /> -->

      <BlogSection recentPosts={recentPosts} />
    </div>
  </div>
</DefaultLayout>
