---
import { Image } from 'astro:assets';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import arcade from '../assets/blog/pure-css-arcade-machine/arcade.png';
import caballo from '../assets/patrocinio/2.avif';
import meme from '../assets/patrocinio/huevo-gallina-sort.jpg';
import retrato from '../assets/patrocinio/5.avif';
import atril from '../assets/patrocinio/caceres-tiktok.webp';
import escenario from '../assets/patrocinio/caceres-traje.webp';
import gala from '../assets/talks/gala-sirviendo-codigo/3.jpg';

// La galería ocupa todo el contenedor hasta que comparte fila con el texto en lg.
const miniaturaSizes = '(min-width: 1280px) 185px, (min-width: 1024px) calc((100vw - 168px) / 6), (min-width: 640px) calc((100vw - 72px) / 3), calc((100vw - 48px) / 3)';
const galaSizes = '(min-width: 1280px) 383px, (min-width: 1024px) calc((100vw - 132px) / 3), (min-width: 640px) calc((200vw - 108px) / 3), calc((200vw - 72px) / 3)';
const miniaturaWidths = [120, 192, 240, 320, 400, 480, 640];

const correo = 'jorge.baumann.aguilar@gmail.com';
const contacto = `mailto:${correo}?subject=Propuesta%20de%20colaboraci%C3%B3n`;
const cifras = [
  ['Seguidores en X', '+25.000'],
  ['Seguidores en LinkedIn', '+20.000'],
  ['Visitas web mensuales', '+2.000'],
];
const propuestas = [
  { titulo: '👓 Visibilidad extrema', texto: 'Olvida los anuncios pagados. Como patrocinador, te daré visibilidad en mis plataformas. Desde menciones en mis live coding sessions hasta shout-outs en mis tweets más sarcásticos.', foto: escenario, alt: 'Jorge Baumann con su traje estampado junto al atril en Cáceres' },
  { titulo: '🥳 Meme expert', texto: '¿Sabías que, además de escribir código, tengo un dominio excelente en materia de memes? Patrocíname y recibirás menciones especiales en mis memes más virales.', foto: meme, alt: '¿Qué fue primero, el huevo o la gallina? En JavaScript, sort() coloca la gallina antes que el huevo.' },
  { titulo: '🎨 CSS Art', texto: 'Dibujo con CSS y HTML, ¿quieres verlo en directo? Patrocíname y recibirás menciones especiales en mis dibujos más creativos.', foto: arcade, alt: 'Máquina recreativa azul de Pac-Man dibujada con CSS' },
];
---

<DefaultLayout title="Patrocina mi contenido | Baumannzone.dev" description="Patrocina mis charlas, demos y contenido sobre desarrollo web. Flexiones en directo y entrada a caballo incluidas en el repertorio.">
  <div class="bg-white text-gray-900">
    <div class="bmn-container mx-auto">
      <header class="grid items-center gap-8 py-12 lg:grid-cols-2 lg:gap-14 lg:py-20">
        <div>
          <h1 class="max-w-xl text-5xl font-black tracking-tight sm:text-6xl">¿Quieres patrocinar mi contenido?</h1>
          <p class="copy mt-6 max-w-lg text-lg">Gana visibilidad y apoya mi trabajo. Si tienes un producto o servicio que pueda interesar a mi audiencia, estaré encantado de hablar contigo.</p>
          <a class="cta mt-7" href={contacto}>Proponer una colaboración</a>
        </div>
        <div class="grid grid-cols-3 gap-2 sm:gap-3">
          <Image src={gala} width={800} widths={[240, 384, 480, 640, 800, 960, 1280]} sizes={galaSizes} fetchpriority="high" alt="Jorge con otros participantes en el escenario de la gala de Sirviendo Código" loading="eager" class="photo col-span-2 row-span-2 h-full min-h-0 object-[40%_center]" />
          <Image src={atril} width={400} height={400} widths={miniaturaWidths} sizes={miniaturaSizes} fit="cover" position="top" alt="Jorge en el atril durante su charla sobre TikTok en Cáceres" class="photo aspect-square object-top" />
          <Image src={retrato} width={260} height={260} widths={miniaturaWidths} sizes={miniaturaSizes} fit="cover" position="top" alt="Retrato en blanco y negro de Jorge Baumann con los brazos cruzados" class="photo aspect-square object-top" />
        </div>
      </header>

      <dl aria-label="Estadísticas de mi contenido" class="flex flex-wrap gap-x-14 gap-y-5 border-y border-gray-200 py-6">
        {cifras.map(([etiqueta, cifra]) => (
          <div class="flex flex-col-reverse gap-1">
            <dt class="copy text-sm">{etiqueta}</dt>
            <dd class="text-3xl font-bold tracking-tight">{cifra}</dd>
          </div>
        ))}
      </dl>

      <section class="py-14 sm:py-20">
        <h2 class="max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">¿Por qué deberías patrocinar mi contenido?</h2>
        <p class="copy mt-4 max-w-2xl">Estarás apoyando a un software engineer apasionado y también tendrás acceso a una serie de beneficios que no sabías que necesitabas.</p>

        <article class="mt-9 grid overflow-hidden rounded-2xl bg-violet-50 md:grid-cols-[2fr_3fr]">
          <Image src={caballo} width={504} widths={[252, 504, 756]} sizes="min(100vw - 2rem, 252px)" quality={70} alt="Jorge montando a caballo en un prado" class="mx-auto h-auto max-h-[28rem] w-full bg-[#e5e8d8] object-contain" />
          <div class="self-center p-6 sm:p-10">
            <h3 class="text-3xl font-bold tracking-tight">🐴 Entrada a caballo en tu evento</h3>
            <p class="copy mt-4 text-lg">¿Tienes una conferencia aburrida? No te preocupes, yo llego a caballo. <strong>Literalmente.</strong></p>
          </div>
        </article>

        <article class="my-10 grid items-center gap-5 md:grid-cols-2 md:gap-10">
          <div>
            <h3 class="text-2xl font-bold">💪 Flexiones en directo</h3>
            <p class="copy mt-3">¿Quién necesita tutoriales de JavaScript cuando puedes verme hacer flexiones en vivo? Exacto, ¡nadie! Y sí, las hago en mi mejor traje para mayor impacto.</p>
          </div>
          <video src="/patrocinio/flexiones-en-directo.mp4" poster="/patrocinio/flexiones-en-directo.jpg" width="720" height="720" controls playsinline preload="none" aria-label="Jorge haciendo flexiones en el escenario de Cáceres" class="w-full max-w-md justify-self-center rounded-xl"></video>
        </article>

        <div class="grid gap-9 sm:grid-cols-3 sm:gap-6">
          {propuestas.map(({ titulo, texto, foto, alt }) => (
            <article>
              <Image src={foto} width={540} widths={[240, 360, 400, 480, 600, 720, 800, 1080, 1200]} sizes="(min-width: 1280px) 389px, (min-width: 1024px) calc((100vw - 112px) / 3), (min-width: 640px) calc((100vw - 96px) / 3), calc(100vw - 32px)" alt={alt} class:list={["photo aspect-[3/2]", { "meme": foto === meme, "object-[center_38%]": foto === escenario }]} />
              <h3 class="mt-4 text-xl font-bold">{titulo}</h3>
              <p class="copy mt-2">{texto}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="border-t border-gray-200 py-12 sm:py-16">
        <h2 class="text-3xl font-bold tracking-tight">🙌 ¿Tienes otra idea?</h2>
        <p class="copy mt-3 max-w-xl">Si tienes una idea para una colaboración, no dudes en decírmelo. Estoy abierto a propuestas y me encantaría escuchar lo que tienes en mente.</p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a class="cta" href={contacto}>Hablemos</a>
          <a class="break-all text-violet-700 underline underline-offset-4" href={contacto}>{correo}</a>
        </div>
      </section>
    </div>
  </div>
</DefaultLayout>

<style>
  .copy { @apply leading-relaxed text-gray-600; }
  .photo { @apply w-full rounded-xl object-cover outline outline-1 -outline-offset-1 outline-black/10; }
  .photo.meme { @apply object-contain; background-color: #efde55; }
  .cta { @apply inline-flex rounded-lg bg-violet-700 px-5 py-3 font-semibold text-white hover:bg-violet-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-500 motion-safe:active:scale-[.96]; }
</style>
