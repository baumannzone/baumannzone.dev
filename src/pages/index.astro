---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BlogSection from "../components/HomePage/BlogSection.astro";
import ProfileSection from "../components/HomePage/ProfileSection.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import RandomSetupItem from "../components/HomePage/RandomSetupItem.astro";
import profileImage from "../components/HomePage/baumannzone.webp";
import { HOME_TITLE, SITE_DESCRIPTION } from "../consts";
import { personSchema, websiteId, websiteSchema } from "../utils/schema";

const homeUrl = new URL("/", Astro.site).href;
const image = await getImage({ src: profileImage, width: 140, height: 140 });
const person = personSchema(Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { ...person, image: new URL(image.src, homeUrl).href },
    websiteSchema(Astro.site, SITE_DESCRIPTION),
    {
      "@type": "WebPage",
      "@id": `${homeUrl}#webpage`,
      url: homeUrl,
      name: HOME_TITLE,
      description: SITE_DESCRIPTION,
      inLanguage: "es",
      isPartOf: { "@id": websiteId(Astro.site) },
      mainEntity: { "@id": person["@id"] },
    },
  ],
};

const posts = (await getCollection("blog"))
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<DefaultLayout title={HOME_TITLE}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
  />
  <ProfileSection />
  <BlogSection posts={posts} />
  <RandomSetupItem />
</DefaultLayout>
