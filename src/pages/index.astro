---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BlogSection from "../components/HomePage/BlogSection.astro";
import ProfileSection from "../components/HomePage/ProfileSection.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import RandomSetupItem from "../components/HomePage/RandomSetupItem.astro";
import profileImage from "../components/HomePage/baumannzone.webp";
import { SITE_DESCRIPTION, SITE_NAME, SITE_OWNER, SITE_TITLE } from "../consts";

const homeUrl = new URL("/", Astro.site).href;
const personId = `${homeUrl}#person`;
const websiteId = `${homeUrl}#website`;
const image = await getImage({ src: profileImage, width: 140, height: 140 });
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: SITE_OWNER.name,
      alternateName: SITE_OWNER.alternateName,
      jobTitle: SITE_OWNER.jobTitle,
      description: SITE_OWNER.description,
      url: homeUrl,
      image: new URL(image.src, homeUrl).href,
      sameAs: Object.values(SITE_OWNER.profiles),
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: SITE_NAME,
      alternateName: new URL(homeUrl).hostname,
      url: homeUrl,
      description: SITE_DESCRIPTION,
      inLanguage: "es",
      publisher: { "@id": personId },
    },
    {
      "@type": "WebPage",
      "@id": `${homeUrl}#webpage`,
      url: homeUrl,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      inLanguage: "es",
      isPartOf: { "@id": websiteId },
      mainEntity: { "@id": personId },
    },
  ],
};

const posts = (await getCollection("blog"))
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<DefaultLayout>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
  />
  <ProfileSection />
  <BlogSection posts={posts} />
  <RandomSetupItem />
</DefaultLayout>
