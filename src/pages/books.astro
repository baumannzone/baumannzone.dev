---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/DefaultLayout.astro';
import BookCard from '../components/BookCard.astro';
import CategoryNavigation from '../components/CategoryNavigation.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_DESCRIPTION } from '../consts';
import {
  breadcrumbSchema,
  personId,
  personSchema,
  websiteId,
  websiteSchema,
} from '../utils/schema';

import {
  bookList as books,
  literatureBooks,
  growthBooks,
  softwareBooks,
} from '../utils/book-list.ts';

const pageTitle = 'Libros de programación y otras lecturas';
const metaDescription =
  'Libros de programación, tecnología, desarrollo personal y novelas que he leído, estoy leyendo o tengo pendientes, con sus autores y portadas.';
const description =
  'Mi biblioteca personal: libros de programación, tecnología, desarrollo personal y novelas. Aquí reúno lo que he leído, lo que estoy leyendo y los libros que tengo pendientes.';
const ogImage = new URL('https://baumannzone-dev-og.vercel.app/api/og');
ogImage.searchParams.set('title', pageTitle);
ogImage.searchParams.set('tags', 'Programación,Desarrollo personal,Novelas');

// Include finished books and current reads; pending books have their own list.
const readLiteratureBooks = literatureBooks.filter(
  (book) => book.status !== 'pending',
);
const readGrowthBooks = growthBooks.filter((book) => book.status !== 'pending');
const readSoftwareBooks = softwareBooks.filter(
  (book) => book.status !== 'pending',
);

// Category display names
const categoryNames = {
  software: 'Programación y tecnología',
  growth: 'Desarrollo personal',
  literature: 'Novelas y ficción',
};

// Filter pending books (regardless of category)
const pendingBooks = books.filter((book) => book.status === 'pending');

// Create categories array for navigation
const categories = [
  ...(readSoftwareBooks.length > 0 ? [{ id: 'software', name: categoryNames.software, count: readSoftwareBooks.length }] : []),
  ...(readGrowthBooks.length > 0 ? [{ id: 'growth', name: categoryNames.growth, count: readGrowthBooks.length }] : []),
  ...(readLiteratureBooks.length > 0 ? [{ id: 'literature', name: categoryNames.literature, count: readLiteratureBooks.length }] : []),
  ...(pendingBooks.length > 0 ? [{ id: 'pending', name: 'Pendientes de leer', count: pendingBooks.length }] : []),
];

const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/books/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

async function bookNode(book: (typeof books)[number]) {
  const cover = covers[`../assets/books/${book.image}`]?.default;
  if (!cover) {
    throw new Error(`No se encuentra la portada de "${book.title}": ${book.image}`);
  }
  const image = await getImage({ src: cover, width: 192 });
  const authors = (Array.isArray(book.author) ? book.author : [book.author])
    .map((author) => author.trim())
    .filter(Boolean);
  const node: Record<string, unknown> = {
    '@type': 'Book',
    name: book.title,
    image: new URL(image.src, Astro.site).href,
  };
  if (authors.length === 1) {
    node.author = { '@type': 'Person', name: authors[0] };
  } else if (authors.length > 1) {
    node.author = authors.map((name) => ({ '@type': 'Person', name }));
  }
  const summary = book.description?.trim();
  if (summary) node.description = summary;
  const link = book.link?.trim();
  if (link) node.url = link;
  return node;
}

function bookListSchema(name: string, nodes: Record<string, unknown>[]) {
  return {
    '@type': 'ItemList',
    name,
    numberOfItems: nodes.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: nodes.map((node, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: node.name,
      item: node,
    })),
  };
}

const readBooks = [
  ...readSoftwareBooks,
  ...readGrowthBooks,
  ...readLiteratureBooks,
];
const readNodes = await Promise.all(readBooks.map(bookNode));
const pendingNodes = await Promise.all(pendingBooks.map(bookNode));
const booksUrl = new URL('/books/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema(Astro.site),
    websiteSchema(Astro.site, SITE_DESCRIPTION),
    {
      '@type': 'CollectionPage',
      '@id': `${booksUrl}#webpage`,
      url: booksUrl,
      name: `${pageTitle} | Baumannzone.dev`,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': websiteId(Astro.site) },
      about: { '@id': personId(Astro.site) },
      mainEntity: bookListSchema('Libros leídos y en lectura', readNodes),
      ...(pendingNodes.length > 0 && {
        hasPart: bookListSchema('Pendientes de leer', pendingNodes),
      }),
    },
    breadcrumbSchema(Astro.site, [
      { name: 'Inicio', path: '/' },
      { name: 'Libros', path: '/books/' },
    ]),
  ],
};
---

<Layout
  title={`${pageTitle} | Baumannzone.dev`}
  description={metaDescription}
  ogImage={ogImage.toString()}
>
  <JsonLd slot='head' data={jsonLd} />
  <div class='bmn-container mx-auto pt-16 pb-24'>
    <header class='text-center mx-auto max-w-3xl'>
      <p class='text-base font-semibold leading-7 text-violet-600'>/books</p>
      <h1 class='text-4xl font-semibold mb-8 text-balance'>{pageTitle}</h1>
      <p class='mt-6 mb-12 text-lg/8 text-gray-600 text-balance'>
        {description}
      </p>
    </header>

    <CategoryNavigation categories={categories} />

    <section class='bg-white m-2 px-4 sm:px-6 lg:px-8'>
      {/* Software & Tecnología */}
      {
        readSoftwareBooks.length > 0 && (
          <div id='software' class='pb-12'>
            <div class='sticky top-0 z-10 bg-white/70 backdrop-blur-sm pt-4 pb-3 mb-1'>
              <h2 class='text-lg tracking-tighter font-bold flex gap-[2px]'>
                <span class='font-mono text-violet-500/50'>/</span>
                {categoryNames.software}
              </h2>
            </div>

            <div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 items-stretch mb-2'>
              {readSoftwareBooks.map((book) => (
                <BookCard book={book} />
              ))}
            </div>
          </div>
        )
      }

      {/* Desarrollo Personal */}
      {
        readGrowthBooks.length > 0 && (
          <div id='growth' class='pb-12'>
            <div class='sticky top-0 z-10 bg-white/70 backdrop-blur-sm pt-4 pb-3 mb-1'>
              <h2 class='text-lg tracking-tighter font-bold flex gap-[2px]'>
                <span class='font-mono text-violet-500/50'>/</span>
                {categoryNames.growth}
              </h2>
            </div>

            <div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 items-stretch mb-2'>
              {readGrowthBooks.map((book) => (
                <BookCard book={book} />
              ))}
            </div>
          </div>
        )
      }

      {/* Novelas & Ficción */}
      {
        readLiteratureBooks.length > 0 && (
          <div id='literature' class='pb-12'>
            <div class='sticky top-0 z-10 bg-white/70 backdrop-blur-sm pt-4 pb-3 mb-1'>
              <h2 class='text-lg tracking-tighter font-bold flex gap-[2px]'>
                <span class='font-mono text-violet-500/50'>/</span>
                {categoryNames.literature}
              </h2>
            </div>

            <div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 items-stretch mb-2'>
              {readLiteratureBooks.map((book) => (
                <BookCard book={book} />
              ))}
            </div>
          </div>
        )
      }
    </section>

    <!-- Pending Books Section -->
    {
      pendingBooks.length > 0 && (
        <section id='pending' class='bg-white m-2 px-4 sm:px-6 lg:px-8 mb-8'>
          <div class='pb-12'>
            <div class='sticky top-0 z-10 bg-white/70 backdrop-blur-sm pt-4 pb-3 mb-1'>
              <h2 class='text-lg tracking-tighter font-bold flex gap-[2px]'>
                <span class='font-mono text-violet-500/50'>/</span>
                Pendientes de leer
              </h2>
            </div>

            <div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 items-stretch mb-2'>
              {pendingBooks.map((book) => (
                <BookCard book={book} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style scoped>
  html {
    scroll-behavior: smooth;
  }
</style>
