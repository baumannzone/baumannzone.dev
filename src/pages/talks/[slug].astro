---
import Layout from "../../layouts/DefaultLayout.astro";
import { getCollection, render } from "astro:content";
import JsonLd from "../../components/JsonLd.astro";
import { breadcrumbSchema, personId } from "../../utils/schema";

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  return talks.map((talk) => ({
    params: { slug: talk.id },
    props: { talk },
  }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);

const typeLabels = {
  conferencia: "Charla",
  podcast: "Podcast",
  artículo: "Artículo",
  meetup: "Meetup",
  curso: "Curso",
  social: "Participación",
};
const description =
  talk.data.description ??
  `${typeLabels[talk.data.type]} «${talk.data.title}» de Jorge Baumann (@baumannzone) en ${talk.data.event} (${talk.data.date.getFullYear()}).`;

const talkUrl = new URL(`/talks/${talk.id}/`, Astro.site).href;
const { title: talkTitle, type, event, date } = talk.data;
const common = {
  "@id": `${talkUrl}#main`,
  name: talkTitle,
  description,
  url: talkUrl,
  inLanguage: "es",
};
// Same type mapping as the microdata in the talks index.
const mainEntity =
  type === "conferencia" || type === "meetup" || type === "social"
    ? {
        "@type": "Event",
        ...common,
        startDate: date.toISOString().slice(0, 10),
        location: { "@type": "Place", name: event },
        performer: { "@id": personId(Astro.site) },
      }
    : type === "podcast"
      ? {
          "@type": "PodcastEpisode",
          ...common,
          datePublished: date.toISOString().slice(0, 10),
          partOfSeries: { "@type": "PodcastSeries", name: event },
          actor: { "@id": personId(Astro.site) },
        }
      : type === "artículo"
        ? {
            "@type": "Article",
            ...common,
            headline: talkTitle,
            datePublished: date.toISOString().slice(0, 10),
            author: { "@id": personId(Astro.site) },
            publisher: { "@type": "Organization", name: event },
          }
        : {
            "@type": "Course",
            ...common,
            provider: { "@type": "Organization", name: event },
            instructor: { "@id": personId(Astro.site) },
          };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    mainEntity,
    breadcrumbSchema(Astro.site, [
      { name: "Inicio", path: "/" },
      { name: "Charlas", path: "/talks/" },
      { name: talkTitle, path: `/talks/${talk.id}/` },
    ]),
  ],
};
---

<Layout
  title={`${talk.data.title} | Baumannzone.dev`}
  description={description}
>
  <JsonLd slot="head" data={jsonLd} />
  <main class="container mx-auto px-4 py-8">
    <article class="prose prose-lg mx-auto prose-img:shadow-lg">
      <header class="mb-8">
        <time
          datetime={talk.data.date.toISOString()}
          class="text-gray-500 text-xs"
        >
          {
            new Date(talk.data.date).toLocaleDateString("es-ES", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <h1
          class="text-4xl font-bold mb-4"
          style={`view-transition-name: talk-${talk.id}`}
        >
          {talk.data.title}
        </h1>
        <div class="flex justify-between gap-4 text-gray-600">
          <span>{talk.data.event}</span>
        </div>
      </header>

      <Content />

      {
        talk.data.links && talk.data.links.length > 0 && (
          <div class="mt-8">
            <h2 class="text-2xl font-bold mb-4">Links</h2>
            <ul class="space-y-2">
              {talk.data.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-violet-500 hover:text-violet-600"
                  >
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </article>
  </main>
</Layout>
