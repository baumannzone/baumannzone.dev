---
import ArticleCard from "../ArticleCard.astro";

const { posts } = Astro.props;
// Artículos recientes que se muestran fijos; el último hueco es aleatorio.
const RECENT_COUNT = 5;
const recentPosts = posts.slice(0, RECENT_COUNT);
// Todos los post menos los recientes.
// Solo los campos que usa la tarjeta: define:vars serializa lo que reciba
// dentro del HTML, y el post completo incluye el cuerpo entero del artículo.
const otherPosts = posts.slice(RECENT_COUNT).map(({ id, data }) => ({
  id,
  data: {
    title: data.title,
    description: data.description,
    pubDate: data.pubDate,
    tags: data.tags ?? [],
  },
}));
---

<div class="bg-white py-24 sm:py-32">
  <div class="mx-auto bmn-container">
    <div class="mx-auto max-w-2xl lg:mx-0">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Últimos artículos del blog
      </h2>
      <p class="mt-2 text-lg leading-8 text-gray-600">
        Aquí tienes mis artículos más recientes y uno aleatorio de regalo
      </p>
      {/* <p class="mt-2 text-lg leading-8 text-gray-600">
        Mejora en tu carrera profesional como developer y sube de nivel
      </p> */}
    </div>

    <div
      class="mt-16 pt-16 border-t border-gray-200 grid grid-cols-1 md:grid-cols-2 gap-6"
    >
      {
        recentPosts.map((post, index) => (
          <ArticleCard post={post} isNew={index === 0} headingLevel={3} />
        ))
      }
      <div id="random-post-container"></div>
    </div>

    <div class="mt-16 text-center">
      <a
        href="/blog/"
        class="group inline-flex items-center gap-1 text-base font-semibold text-violet-700 hover:text-violet-500 transition-colors"
      >
        Ver todos los artículos del blog
        <span
          aria-hidden="true"
          class="inline-block transition-transform group-hover:translate-x-1"
          >→</span
        >
      </a>
    </div>
  </div>
</div>

{/* Get all posts to get a random one */}
<script define:vars={{ otherPosts }}>
  // Random post
  const randomIndex = Math.floor(Math.random() * otherPosts.length);
  const randomPost = otherPosts[randomIndex];

  // Convert pubDate string to Date object
  const pubDate = new Date(randomPost.data.pubDate);

  // ADD random post to the DOM
  const randomPostContainer = document.getElementById("random-post-container");
  // Article card with random post
  randomPostContainer.innerHTML = `
<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-zinc-200 transition-[box-shadow] duration-200 ease-out hover:shadow-md hover:ring-zinc-300 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-violet-500">
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <time class="text-[13px] text-zinc-500" datetime="${pubDate.toISOString()}">
        ${pubDate.toLocaleDateString("es-ES", {
          year: "numeric",
          month: "short",
          day: "2-digit",
        })}
      </time>
      <span class="inline-flex items-center rounded-md bg-violet-50 px-2 py-0.5 font-medium text-violet-700 ring-1 ring-inset ring-violet-600/20">
        Aleatorio
      </span>
    </div>
    <h3
      class="text-xl font-semibold leading-snug text-zinc-950 text-balance"
      style="view-transition-name: post-${randomPost.id}"
    >
      <a href="/blog/${randomPost.id}/" class="focus:outline-none">
        <span class="absolute inset-0"></span>
        ${randomPost.data.title}
      </a>
    </h3>
    <p class="line-clamp-3 text-sm leading-6 text-zinc-600">
      ${randomPost.data.description}
    </p>
  </div>
  <div class="flex items-center justify-between gap-4 border-t border-zinc-100 bg-zinc-50 px-6 py-3.5">
    <span class="text-[13px] font-medium text-zinc-600">${randomPost.data.tags.join(" · ")}</span>
    <span aria-hidden="true" class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-violet-700">
      Leer
      <span class="inline-block transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transform-none">→</span>
    </span>
  </div>
</article>
  `;
</script>
