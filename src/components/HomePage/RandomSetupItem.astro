---
import myUses from "../UsesPage/uses.js";
import { Image } from "astro:assets";
import setupImage from "../../assets/baumannzone-desktop-origami.webp";

const VISIBLE_COUNT = 3;

// Every Amazon item, with its section as the category. They are all in the
// HTML, hidden; the script below shows three random ones on each visit (the
// first three stay visible without JavaScript).
const amazonItems = myUses.flatMap((section) =>
  (section.children ?? [])
    .filter((item) => item.link?.includes("amzn.to"))
    .map((item) => ({ ...item, category: section.title })),
);

// The /uses/ sections, grouped for the "Mi setup completo" tiles. A section
// that is not listed here still counts towards the total.
const GROUPS = [
  {
    label: "Hardware y periféricos",
    icon: "M4 5h16v11H4zM2 19h20",
    sections: ["Portátil", "Pantallas", "Ratón", "Alfombrilla", "Teclado", "Micrófono", "Auriculares", "Altavoces"],
  },
  {
    label: "Mesa, silla, luces y cables",
    icon: "M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5V16h8v-2.5A6 6 0 0 0 12 3z",
    sections: ["Silla", "Mesa o Escritorio", "Luces", "Adaptadores", "Cables y conexiones"],
  },
  {
    label: "Software, plugins e IA",
    icon: "M8 6l-6 6 6 6M16 6l6 6-6 6",
    sections: ["Editor", "Plugins Editor", "Fuentes o Tipografías para programar", "Terminal", "Navegador", "Desktop", "Móvil", "Extensiones Navegador", "Inteligencia Artificial"],
  },
  {
    label: "Gadgets y eventos",
    icon: "M9 9h6v6H9zM7 7l2 2M17 7l-2 2M7 17l2-2M17 17l-2-2M5 3a2 2 0 1 0 0 4a2 2 0 1 0 0-4M19 3a2 2 0 1 0 0 4a2 2 0 1 0 0-4M5 17a2 2 0 1 0 0 4a2 2 0 1 0 0-4M19 17a2 2 0 1 0 0 4a2 2 0 1 0 0-4",
    sections: ["Gadgets & Tools", "Eventos y miscelánea"],
  },
];

const countOf = (section) => section.children?.length ?? 0;
const totalItems = myUses.reduce((sum, section) => sum + countOf(section), 0);
const setupGroups = GROUPS.map((group) => ({
  ...group,
  count: myUses
    .filter((section) => group.sections.includes(section.title))
    .reduce((sum, section) => sum + countOf(section), 0),
}));
---

<section class="bg-white py-24 sm:py-32">
  <div class="mx-auto bmn-container">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          ¿Sabías que uso…?
        </h2>
        <p class="mt-2 text-lg leading-8 text-gray-600">
          Tres cosas de mi setup, elegidas al azar
        </p>
      </div>
      <button
        type="button"
        id="setup-shuffle"
        hidden
        class="inline-flex min-h-11 shrink-0 items-center gap-2 self-start rounded-lg bg-white px-4 text-sm font-semibold text-zinc-700 shadow-sm ring-1 ring-zinc-200 transition-[box-shadow] duration-200 ease-out hover:shadow-md hover:ring-zinc-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 sm:self-auto"
      >
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path>
          <path d="M21 3v5h-5"></path>
        </svg>
        Otras tres
      </button>
    </div>

    <ul
      id="setup-items"
      class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3"
      aria-live="polite"
    >
      {
        amazonItems.map((item, index) => (
          <li hidden={index >= VISIBLE_COUNT}>
            <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-zinc-200 transition-[box-shadow] duration-200 ease-out hover:shadow-md hover:ring-zinc-300 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-violet-500">
              <div class="flex flex-1 flex-col gap-2.5 p-6">
                <span class="text-xs font-semibold uppercase tracking-wider text-violet-700">
                  {item.category}
                </span>
                <h3 class="text-lg font-semibold leading-snug text-zinc-950 text-balance">
                  <a
                    href={item.link}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                    class="focus:outline-none"
                  >
                    <span class="absolute inset-0" />
                    {item.title}
                  </a>
                </h3>
                {item.description && (
                  <p class="line-clamp-4 text-sm leading-6 text-zinc-600">
                    {item.description}
                  </p>
                )}
              </div>
              <div class="flex items-center justify-between gap-4 border-t border-zinc-100 bg-zinc-50 px-6 py-3.5">
                <span class="text-[13px] font-medium text-zinc-600">Amazon</span>
                <span
                  aria-hidden="true"
                  class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-violet-700"
                >
                  Ver
                  <span class="inline-block transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transform-none">
                    ↗
                  </span>
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <a
      href="/uses/"
      class="group mt-6 grid grid-cols-2 gap-4 rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-4 md:grid-cols-4 md:grid-rows-[156px_156px]"
    >
      <div
        class="relative col-span-2 overflow-hidden rounded-2xl bg-zinc-200 max-md:aspect-[4/3] md:row-span-2"
      >
        <Image
          src={setupImage}
          alt="Mi setup de trabajo como software engineer"
          widths={[560, 1120]}
          sizes="(min-width: 768px) 560px, 100vw"
          class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transform-none"
        />
        <div
          class="absolute inset-x-3 bottom-3 flex flex-wrap items-center justify-between gap-3 rounded-xl bg-white/55 p-4 shadow-lg ring-1 ring-inset ring-white/60 backdrop-blur-md backdrop-saturate-150 sm:inset-x-4 sm:bottom-4"
        >
          <div class="flex min-w-0 flex-col">
            <span class="text-lg font-bold text-zinc-950">Mi setup completo</span>
            <span class="text-[13px] text-zinc-700">
              {totalItems} cosas que uso para trabajar, grabar y trastear
            </span>
          </div>
          <span
            class="inline-flex min-h-10 shrink-0 items-center gap-1.5 rounded-lg bg-violet-700 px-3.5 text-sm font-semibold text-white"
          >
            Ver setup
            <span
              aria-hidden="true"
              class="inline-block transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transform-none"
              >→</span
            >
          </span>
        </div>
      </div>

      {
        setupGroups.map((group) => (
          <div class="flex flex-col justify-between gap-6 rounded-2xl bg-zinc-50 p-5 ring-1 ring-inset ring-zinc-100">
            <span class="flex size-10 items-center justify-center rounded-xl bg-white text-violet-700 ring-1 ring-zinc-200">
              <svg
                aria-hidden="true"
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={group.icon} />
              </svg>
            </span>
            <span class="flex flex-col gap-0.5">
              <span class="text-4xl font-extrabold leading-none tracking-tight tabular-nums text-zinc-950">
                {group.count}
              </span>
              <span class="text-[13px] font-medium text-zinc-600">
                {group.label}
              </span>
            </span>
          </div>
        ))
      }
    </a>
  </div>
</section>

<script define:vars={{ VISIBLE_COUNT }}>
  const list = document.getElementById("setup-items");
  const button = document.getElementById("setup-shuffle");
  const items = [...list.children];
  let current = [];

  const icon = button.querySelector("svg");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const STAGGER = 60;

  // Pick VISIBLE_COUNT random items, avoiding the ones on screen when there
  // are enough left to choose from.
  const pick = () => {
    const fresh = items.filter((item) => !current.includes(item));
    const pool = fresh.length >= VISIBLE_COUNT ? fresh : items;
    return [...pool]
      .sort(() => Math.random() - 0.5)
      .slice(0, VISIBLE_COUNT)
      .sort((a, b) => items.indexOf(a) - items.indexOf(b)); // left to right
  };

  const show = (picked) => {
    items.forEach((item) => {
      item.hidden = !picked.includes(item);
    });
    current = picked;
  };

  // Each card in turn: the old ones drop out, the new ones rise in.
  const animate = (cards, keyframes, options) =>
    Promise.all(
      cards.map(
        (card, i) =>
          card.animate(keyframes, {
            fill: "both",
            delay: i * STAGGER,
            ...options,
          }).finished,
      ),
    );

  const shuffle = async () => {
    const picked = pick();
    if (reducedMotion.matches) return show(picked);

    button.disabled = true;
    icon.animate([{ transform: "rotate(0)" }, { transform: "rotate(360deg)" }], {
      duration: 500,
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
    });

    const outgoing = current;
    await animate(
      outgoing,
      [
        { opacity: 1, transform: "translateY(0) scale(1)" },
        { opacity: 0, transform: "translateY(8px) scale(0.97)" },
      ],
      { duration: 160, easing: "ease-in" },
    );
    outgoing.forEach((card) => card.getAnimations().forEach((a) => a.cancel()));

    show(picked);
    await animate(
      picked,
      [
        { opacity: 0, transform: "translateY(16px) scale(0.97)" },
        { opacity: 1, transform: "translateY(0) scale(1)" },
      ],
      { duration: 420, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
    );
    picked.forEach((card) => card.getAnimations().forEach((a) => a.cancel()));
    button.disabled = false;
  };

  show(pick());
  button.hidden = false;
  button.addEventListener("click", shuffle);
</script>
