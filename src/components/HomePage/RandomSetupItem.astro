---
import myUses from "../UsesPage/uses.js";
import { Image } from "astro:assets";
import setupImage from "../../assets/baumannzone-desktop-origami.webp";

const VISIBLE_COUNT = 3;

// Every Amazon item, with its section as the category. They are all in the
// HTML, hidden; the script below shows three random ones on each visit (the
// first three stay visible without JavaScript).
const amazonItems = myUses.flatMap((section) =>
  (section.children ?? [])
    .filter((item) => item.link?.includes("amzn.to"))
    .map((item) => ({ ...item, category: section.title })),
);
---

<section class="bg-white py-24 sm:py-32">
  <div class="mx-auto bmn-container">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          ¿Sabías que uso…?
        </h2>
        <p class="mt-2 text-lg leading-8 text-gray-600">
          Tres cosas de mi setup, elegidas al azar
        </p>
      </div>
      <button
        type="button"
        id="setup-shuffle"
        hidden
        class="inline-flex min-h-11 shrink-0 items-center gap-2 self-start rounded-lg bg-white px-4 text-sm font-semibold text-zinc-700 shadow-sm ring-1 ring-zinc-200 transition-[box-shadow] duration-200 ease-out hover:shadow-md hover:ring-zinc-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 sm:self-auto"
      >
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path>
          <path d="M21 3v5h-5"></path>
        </svg>
        Otras tres
      </button>
    </div>

    <ul
      id="setup-items"
      class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3"
      aria-live="polite"
    >
      {
        amazonItems.map((item, index) => (
          <li hidden={index >= VISIBLE_COUNT}>
            <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-zinc-200 transition-[box-shadow] duration-200 ease-out hover:shadow-md hover:ring-zinc-300 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-violet-500">
              <div class="flex flex-1 flex-col gap-2.5 p-6">
                <span class="text-xs font-semibold uppercase tracking-wider text-violet-700">
                  {item.category}
                </span>
                <h3 class="text-lg font-semibold leading-snug text-zinc-950 text-balance">
                  <a
                    href={item.link}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                    class="focus:outline-none"
                  >
                    <span class="absolute inset-0" />
                    {item.title}
                  </a>
                </h3>
                {item.description && (
                  <p class="line-clamp-4 text-sm leading-6 text-zinc-600">
                    {item.description}
                  </p>
                )}
              </div>
              <div class="flex items-center justify-between gap-4 border-t border-zinc-100 bg-zinc-50 px-6 py-3.5">
                <span class="text-[13px] font-medium text-zinc-600">Amazon</span>
                <span
                  aria-hidden="true"
                  class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-violet-700"
                >
                  Ver
                  <span class="inline-block transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transform-none">
                    ↗
                  </span>
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <a
      href="/uses/"
      class="group mt-6 flex flex-col gap-4 rounded-2xl bg-zinc-50 p-4 ring-1 ring-inset ring-zinc-100 transition-colors hover:bg-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 sm:flex-row sm:items-center sm:gap-6 sm:pr-7"
    >
      <Image
        src={setupImage}
        alt="Mi setup de trabajo como software engineer"
        width={336}
        height={224}
        class="h-28 w-full shrink-0 rounded-xl bg-zinc-200 object-cover sm:w-[168px]"
      />
      <div class="flex min-w-0 flex-1 flex-col gap-1">
        <span class="text-lg font-semibold text-zinc-950">Mi setup completo</span>
        <span class="text-sm leading-6 text-zinc-600">
          Portátil, pantallas, periféricos, silla, mesa, gadgets, editor y
          plugins.
        </span>
      </div>
      <span class="inline-flex shrink-0 items-center gap-1 text-[15px] font-semibold text-violet-700">
        Ver setup
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transform-none"
          >→</span
        >
      </span>
    </a>

    <p class="mt-4 text-xs text-zinc-500">
      Los enlaces a Amazon son de afiliado.
    </p>
  </div>
</section>

<script define:vars={{ VISIBLE_COUNT }}>
  const list = document.getElementById("setup-items");
  const button = document.getElementById("setup-shuffle");
  const items = [...list.children];
  let current = [];

  const icon = button.querySelector("svg");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const STAGGER = 60;

  // Pick VISIBLE_COUNT random items, avoiding the ones on screen when there
  // are enough left to choose from.
  const pick = () => {
    const fresh = items.filter((item) => !current.includes(item));
    const pool = fresh.length >= VISIBLE_COUNT ? fresh : items;
    return [...pool]
      .sort(() => Math.random() - 0.5)
      .slice(0, VISIBLE_COUNT)
      .sort((a, b) => items.indexOf(a) - items.indexOf(b)); // left to right
  };

  const show = (picked) => {
    items.forEach((item) => {
      item.hidden = !picked.includes(item);
    });
    current = picked;
  };

  // Each card in turn: the old ones drop out, the new ones rise in.
  const animate = (cards, keyframes, options) =>
    Promise.all(
      cards.map(
        (card, i) =>
          card.animate(keyframes, {
            fill: "both",
            delay: i * STAGGER,
            ...options,
          }).finished,
      ),
    );

  const shuffle = async () => {
    const picked = pick();
    if (reducedMotion.matches) return show(picked);

    button.disabled = true;
    icon.animate([{ transform: "rotate(0)" }, { transform: "rotate(360deg)" }], {
      duration: 500,
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
    });

    const outgoing = current;
    await animate(
      outgoing,
      [
        { opacity: 1, transform: "translateY(0) scale(1)" },
        { opacity: 0, transform: "translateY(8px) scale(0.97)" },
      ],
      { duration: 160, easing: "ease-in" },
    );
    outgoing.forEach((card) => card.getAnimations().forEach((a) => a.cancel()));

    show(picked);
    await animate(
      picked,
      [
        { opacity: 0, transform: "translateY(16px) scale(0.97)" },
        { opacity: 1, transform: "translateY(0) scale(1)" },
      ],
      { duration: 420, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
    );
    picked.forEach((card) => card.getAnimations().forEach((a) => a.cancel()));
    button.disabled = false;
  };

  show(pick());
  button.hidden = false;
  button.addEventListener("click", shuffle);
</script>
