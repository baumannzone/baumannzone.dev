---
import type { CollectionEntry } from "astro:content";

// Shared by the talks page and the home page.
interface Props {
  talk: CollectionEntry<"talks">;
}

const { talk } = Astro.props;
const { date, type, event, title } = talk.data;
const isUpcoming = date > new Date();

// Frontmatter dates are UTC midnight: format in UTC so the day doesn't shift.
const fmt = (options: Intl.DateTimeFormatOptions) =>
  date.toLocaleDateString("es-ES", { timeZone: "UTC", ...options });
const day = fmt({ day: "numeric" });
const month = fmt({ month: "short" }).replace(".", "");
const year = fmt({ year: "numeric" });
const fullDate = fmt({ day: "numeric", month: "long", year: "numeric" });
---

<a
  href={`/talks/${talk.id}/`}
  class="group relative flex h-full gap-5 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-zinc-200 transition-[box-shadow] duration-200 ease-out hover:shadow-md hover:ring-zinc-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 sm:p-6"
>
  <time
    datetime={date.toISOString().slice(0, 10)}
    title={fullDate}
    class="flex w-16 shrink-0 flex-col items-center justify-center self-start rounded-xl bg-zinc-50 py-2.5 ring-1 ring-inset ring-zinc-200"
  >
    <span class="text-xs font-semibold uppercase tracking-wide text-violet-600">
      {month}
    </span>
    <span class="text-2xl font-bold leading-tight tabular-nums text-zinc-900">
      {day}
    </span>
    <span class="text-xs tabular-nums text-zinc-500">{year}</span>
  </time>

  <div class="flex min-w-0 flex-1 flex-col gap-2 pr-6">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class="inline-flex items-center rounded-md bg-violet-50 px-2 py-0.5 text-xs font-medium capitalize text-violet-700 ring-1 ring-inset ring-violet-600/20"
      >
        {type}
      </span>
      {
        isUpcoming && (
          <span class="inline-flex items-center gap-1.5 rounded-md bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
            <span class="relative flex size-1.5">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-green-400 opacity-75 motion-reduce:hidden" />
              <span class="relative inline-flex size-1.5 rounded-full bg-green-500" />
            </span>
            Próxima
          </span>
        )
      }
    </div>

    <h3
      class="text-lg font-semibold leading-snug text-zinc-950 text-balance sm:text-xl"
      style={`view-transition-name: talk-${talk.id}`}
    >
      {title}
    </h3>

    <p class="text-sm text-zinc-500">{event}</p>
  </div>

  <span
    aria-hidden="true"
    class="absolute right-5 top-5 text-zinc-300 transition duration-200 ease-out group-hover:translate-x-1 group-hover:text-violet-600 motion-reduce:transform-none sm:right-6 sm:top-6"
    >→</span
  >
</a>
