---
import type { CollectionEntry } from "astro:content";

// Shared by the talks page and the home page.
interface Props {
  talk: CollectionEntry<"talks">;
}

const { talk } = Astro.props;
const isUpcoming = talk.data.date > new Date();
---

<a
  href={`/talks/${talk.id}/`}
  class="block hover:bg-zinc-200 rounded-xl transition group focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2"
>
  <div class="rounded-xl border-2 border-zinc-200 h-full">
    <div class="flex flex-col space-y-1.5 p-6">
      <div class="flex items-start justify-between gap-3">
        <div class="text-sm text-zinc-500 min-w-0">{talk.data.event}</div>
        <div class="shrink-0 bg-zinc-200 rounded-lg">
          <div
            class="px-2.5 py-0.5 font-semibold text-zinc-950 rounded-lg text-xs group-hover:bg-white transition-colors flex items-center"
          >
            <span class="mr-1">{talk.data.type}</span>
            <div
              class={`size-[6px] rounded-full ${isUpcoming ? "bg-green-500" : "bg-gray-400"}`}
              title={isUpcoming ? "Próxima charla" : "Charla pasada"}
            />
          </div>
        </div>
      </div>
      <h3
        class="text-2xl font-semibold tabular-nums text-zinc-950"
        style={`view-transition-name: talk-${talk.id}`}
      >
        {talk.data.title}
      </h3>
    </div>
  </div>
</a>
