---
import type { Tags } from '../types/tags';
import { SITE_OWNER } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  slug: string;
  ogImage?: string;
  tags?: Tags[];
  author?: string;
}

const { 
  title, 
  description, 
  pubDate, 
  updatedDate, 
  slug, 
  ogImage,
  tags,
  author = SITE_OWNER.name
} = Astro.props;

const homeUrl = new URL('/', Astro.site).href;
const url = new URL(`/blog/${slug}`, homeUrl).href;
const publisher = {
  '@type': 'Person',
  '@id': `${homeUrl}#person`,
  name: SITE_OWNER.name,
  url: homeUrl,
  sameAs: Object.values(SITE_OWNER.profiles),
};
const publishedDate = pubDate.toISOString();
const modifiedDate = updatedDate ? updatedDate.toISOString() : publishedDate;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: ogImage,
  url: url,
  datePublished: publishedDate,
  dateModified: modifiedDate,
  inLanguage: 'es-ES',
  ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
  author: author === SITE_OWNER.name
    ? publisher
    : { '@type': 'Person', name: author },
  publisher,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
  articleSection: 'Technology',
  articleBody: description
};
---

<script type='application/ld+json' is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
