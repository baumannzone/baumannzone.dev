---
interface Props {
  /** Texto que aparece tras "DEMO /" en la barra superior */
  name?: string;
  /** Pastilla opcional a la derecha de la barra (p. ej. "Resultado") */
  tag?: string;
  /** Reparte los hijos en columnas (2 en escritorio, 1 en móvil) */
  columns?: boolean;
}

const { name, tag, columns = false } = Astro.props;
---

<section class="demo not-prose" aria-label={name ? `Demo: ${name}` : "Demo"}>
  <header class="demo__bar">
    <div class="demo__title">
      <span class="demo__dot" aria-hidden="true"></span>
      <span class="demo__label">Demo</span>
      {name && <span class="demo__name">/ {name}</span>}
    </div>
    {tag && <span class="demo__tag">{tag}</span>}
  </header>

  <div class:list={["demo__body", { "demo__body--columns": columns }]}>
    <slot />
  </div>
</section>

<style is:global>
  .demo {
    --demo-accent: #8b5cf6;
    --demo-bg: #fafafb;
    --demo-bar-bg: #f3f3f6;
    --demo-border: rgb(15 18 30 / 0.1);
    --demo-divider: rgb(15 18 30 / 0.08);
    --demo-dots: rgb(15 18 30 / 0.1);
    --demo-text: #3f4354;
    --demo-muted: #7c8296;
    --demo-caption: #5d6275;
    --demo-code: #6d28d9;
    --demo-code-bg: rgb(15 18 30 / 0.05);
    --demo-tag-border: rgb(15 18 30 / 0.12);
    --demo-shadow: 0 8px 24px rgb(15 18 30 / 0.06);
    --demo-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

    display: flex;
    flex-direction: column;
    margin-block: 2rem;
    border: 1px solid var(--demo-border);
    border-radius: 14px;
    background: var(--demo-bg);
    overflow: hidden;
    box-shadow: var(--demo-shadow);
  }

  @media (prefers-color-scheme: dark) {
    .demo {
      --demo-accent: #8b6cf0;
      --demo-bg: #2b2f3c;
      --demo-bar-bg: #323646;
      --demo-border: rgb(255 255 255 / 0.09);
      --demo-divider: rgb(255 255 255 / 0.07);
      --demo-dots: rgb(255 255 255 / 0.08);
      --demo-text: #b8bccb;
      --demo-muted: #7c8296;
      --demo-caption: #9aa0b4;
      --demo-code: #c9c2ff;
      --demo-code-bg: rgb(255 255 255 / 0.06);
      --demo-tag-border: rgb(255 255 255 / 0.1);
      --demo-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04),
        0 12px 32px rgb(10 12 20 / 0.35);
    }
  }

  /* Barra superior */
  .demo__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 0 16px;
    background: var(--demo-bar-bg);
    border-bottom: 1px solid var(--demo-divider);
  }

  .demo__title {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-family: var(--demo-mono);
    font-size: 12px;
  }

  .demo__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--demo-accent);
  }

  .demo__label {
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--demo-text);
  }

  .demo__name {
    color: var(--demo-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .demo__tag {
    flex: none;
    font-family: var(--demo-mono);
    font-size: 11px;
    color: var(--demo-caption);
    border: 1px solid var(--demo-tag-border);
    border-radius: 999px;
    padding: 3px 10px;
  }

  /* Cuerpo con rejilla de puntos */
  .demo__body {
    padding: 32px;
    background-color: var(--demo-bg);
    background-image: radial-gradient(var(--demo-dots) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .demo__body--columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
  }

  /* Cada columna: demo centrada, pie siempre abajo */
  .demo__item {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .demo__stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
  }

  .demo__caption {
    font-size: 14px;
    color: var(--demo-caption);
    text-align: center;
  }

  .demo__caption code {
    font-family: var(--demo-mono);
    font-size: 13px;
    color: var(--demo-code);
    background: var(--demo-code-bg);
    padding: 3px 8px;
    border-radius: 6px;
  }

  @media (max-width: 640px) {
    .demo__body {
      padding: 24px 16px;
    }
    .demo__tag {
      display: none;
    }
  }
</style>
