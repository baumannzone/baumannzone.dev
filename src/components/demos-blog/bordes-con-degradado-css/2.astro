---
import DemoLayout from "../demo-layout.astro";
---

<DemoLayout name="linear-gradient" tag="Resultado" columns>
  <figure class="demo__item">
    <div class="demo__stage">
      <div class="box with-border"></div>
    </div>
    <figcaption class="demo__caption">Como borde</figcaption>
  </figure>

  <figure class="demo__item">
    <div class="demo__stage">
      <div class="box with-background"></div>
    </div>
    <figcaption class="demo__caption">Como fondo</figcaption>
  </figure>
</DemoLayout>

<style>
  .box {
    width: 100px;
    height: 100px;
  }

  .with-border {
    border-style: solid;
    border-width: 10px;
    border-image: linear-gradient(45deg, red, lime, blue) 1;
  }

  .with-background {
    background: linear-gradient(45deg, red, lime, blue);
  }
</style>
