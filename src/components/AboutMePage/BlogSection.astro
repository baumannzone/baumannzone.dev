---
import ArticleCard from "../ArticleCard.astro";

const { recentPosts } = Astro.props;
---

<!-- Blog section -->
<div class="mx-auto my-32 max-w-7xl px-6 sm:mt-40 lg:px-8">
  <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
      Desde el blog
    </h2>
    <p class="mt-2 text-lg leading-8 text-gray-600">
      Esto es lo último que he escrito en el blog.
    </p>
  </div>
  <div
    class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-6 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3"
  >
    {
      recentPosts.map((post, index) => (
        <ArticleCard post={post} isNew={index === 0} headingLevel={3} />
      ))
    }
  </div>
</div>
