---
import FormattedDate from "./FormattedDate.astro";

// isBlog: blog post in the blog page
// isNew: newest post with green label
// Otherwise, blog post in the home page
// headingLevel: 2 in the blog page (under the h1), 3 in the home page
// (under the section h2)
interface Props {
  isNew?: boolean;
  headingLevel?: 2 | 3;
  post: {
    id: string;
    data: any;
  };
}

const { post, isNew = false, headingLevel = 2 } = Astro.props;
const articleUrl = `/blog/${post.id}/`;
const Heading = `h${headingLevel}`;
---

<article>
  <div class="group relative">
    <div class="flex items-center gap-x-4 text-xs">
      <FormattedDate date={post.data.pubDate} className="text-gray-500" />
      {
        isNew ? (
          <span class="bg-green-500 text-white text-xs font-medium px-2.5 py-0.5 rounded">
            🌶️ New
          </span>
        ) : null
      }
    </div>
    <Heading
      class="mt-2 text-lg font-semibold text-gray-900 group-hover:text-gray-600 transition-colors"
      style={`view-transition-name: post-${post.id}`}
    >
      {/* The title is the link: its text is the anchor text crawlers read.
          The absolute span stretches it so the whole card stays clickable. */}
      <a href={articleUrl}>
        <span class="absolute inset-0"></span>
        {post.data.title}
      </a>
    </Heading>
    <p class="mt-4 mb-4 text-sm leading-6 text-gray-600">
      {post.data.description}
    </p>

    <span
      aria-hidden="true"
      class="text-sm font-semibold leading-6 text-violet-700 group-hover:text-violet-500 transition-colors"
    >
      Ver más
      <span
        class="inline-block ms-0 transition-transform group-hover:translate-x-1"
      >
        →
      </span>
    </span>
  </div>
</article>
