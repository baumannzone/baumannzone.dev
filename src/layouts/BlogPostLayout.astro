---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogJsonLd from '../components/BlogJsonLd.astro';
import AiSummaryLinks from '../components/AiSummaryLinks.astro';
import Footer from '../components/Footer.astro';
import ScreenSaver from '../components/ScreenSaver.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SharePostBar from '../components/SharePostBar.astro';
import NavBar from '../components/NavBar.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { getTagUrl } from '../utils/tags';

type Props = CollectionEntry<'blog'>['data'] & {
  id: string;
  slug: string;
  collection: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  id,
  slug,
  collection,
  author,
  ogImage,
  relatedPosts,
  intro,
} = Astro.props;

// Dont show comments in dev mode
const showComments = !import.meta.env.DEV;
const postUrl = new URL(`/blog/${slug}/`, Astro.site).href;
---

<html lang='es'>
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType='article'
    />
    <BlogJsonLd
      title={title}
      description={description}
      pubDate={pubDate}
      updatedDate={updatedDate}
      slug={slug}
      ogImage={ogImage}
      tags={tags}
      author={author}
    />
  </head>

  <body class='dark:bg-gray-700'>
    <NavBar />
    <main class='px-4 py-8'>
      <div
        class='absolute inset-x-2 -top-6 -z-10 h-12 -rotate-3 bg-gradient-to-r from-violet-300 via-pink-300 to-sky-300 blur-3xl dark:from-violet-500/90 dark:via-pink-500/70 dark:to-sky-500/80'
      >
      </div>
      <meta property='article:published_time' content={pubDate.toISOString()} />
      {
        updatedDate && (
          <meta
            property='article:modified_time'
            content={updatedDate.toISOString()}
          />
        )
      }
      <header class='max-w-prose mx-auto'>
        <div class='text-gray-500 text-xs dark:text-gray-400'>
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <div>
                Actualizado el <FormattedDate date={updatedDate} />
              </div>
            )
          }
        </div>
        <h1
          style={`view-transition-name: post-${slug}`}
          class='text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white'
        >
          {title}
        </h1>
        {
          tags && (
            <ul class='flex gap-x-4 text-xs mt-4 mb-8'>
              {tags.map((tag) => (
                <li>
                  <a href={`/tags/${getTagUrl(tag)}/`}>
                    <span
                      class='relative rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 dark:text-gray-300 dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'
                      translate='no'
                    >
                      {tag}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>
      <div class='max-w-prose mx-auto'>
        <AiSummaryLinks title={title} url={postUrl} />
      </div>
      <article
        class:list={[
          'prose dark:prose-invert prose-lg mx-auto mb-12 prose-hr:border-gray-200 dark:prose-hr:border-gray-600 max-sm:prose-table:block max-sm:prose-table:overflow-x-auto',
          intro &&
            '[&>p:first-child]:border-l-[3px] [&>p:first-child]:border-violet-500 [&>p:first-child]:pl-5 [&>p:first-child]:text-xl/[1.65] [&>p:first-child]:text-gray-900 dark:[&>p:first-child]:text-gray-50',
        ]}
      >
        <slot />
      </article>
      <span id="section-copy-status" role="status" class="sr-only"></span>

      <hr
        class='bg-violet-500 h-[100px] w-[4px] mx-auto my-[80px] rounded-full border-none'
      />

      <SharePostBar id={id} slug={slug} collection={collection} title={title} />

      {
        relatedPosts && relatedPosts.length > 0 && (
          <RelatedPosts relatedSlugs={relatedPosts} />
        )
      }

      {
        showComments && (
          <div class='giscus prose prose-lg mx-auto mb-12' />
        )
      }

      {
        showComments && (
          <script
            src='https://giscus.app/client.js'
            data-repo='baumannzone/baumannzonedev-comments'
            data-repo-id='R_kgDOHJPgsA'
            data-category='Comments'
            data-category-id='DIC_kwDOHJPgsM4CfuZO'
            data-mapping='pathname'
            data-strict='0'
            data-reactions-enabled='1'
            data-emit-metadata='0'
            data-input-position='bottom'
            data-theme='preferred_color_scheme'
            data-lang='es'
            data-loading='lazy'
            crossorigin='anonymous'
            async
          />
        )
      }
    </main>

    <Footer />
    <ScreenSaver />
  </body>
</html>

<script>
  function linkSectionHeadings() {
    for (const heading of document.querySelectorAll('article.prose h2[id]')) {
      if (heading.querySelector('.section-copy')) continue;

      const fragment = '#' + encodeURIComponent(heading.id);
      const section = heading.textContent?.trim();
      if (!heading.querySelector('a, button')) {
        const anchor = document.createElement('a');
        anchor.className = 'section-anchor';
        anchor.href = fragment;
        anchor.append(...heading.childNodes);
        heading.append(anchor);
      }

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'section-copy';
      copy.textContent = '#';
      copy.title = 'Copiar enlace a esta sección';
      copy.setAttribute('aria-label', `Copiar enlace a la sección «${section}»`);
      let reset: number;
      copy.addEventListener('click', async () => {
        const url = new URL(fragment, window.location.href).href;
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          window.prompt('Copia el enlace a esta sección', url);
          return;
        }

        copy.textContent = '✓';
        const status = document.getElementById('section-copy-status');
        if (status) status.textContent = `Enlace a «${section}» copiado`;
        window.clearTimeout(reset);
        reset = window.setTimeout(() => { copy.textContent = '#'; }, 1800);
      });
      heading.append(' ', copy);
    }
  }

  linkSectionHeadings();
  document.addEventListener('astro:page-load', linkSectionHeadings);
</script>

<style>
  article :global(h2 > .section-anchor) {
    color: inherit;
    font-weight: inherit;
    text-decoration: none;
  }

  article :global(h2 > .section-anchor:is(:hover, :focus-visible)) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  article :global(.section-copy) {
    min-width: 1.75rem;
    min-height: 1.75rem;
    font-size: 0.7em;
    vertical-align: middle;
    color: var(--tw-prose-links);
    opacity: 0.7;
  }

  article :global(.section-copy:is(:hover, :focus-visible)) {
    opacity: 1;
  }
</style>
